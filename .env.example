# Mẫu biến môi trường của troly, theo docs/10-backend/10-kien-truc-backend.md mục 3.6 (danh sách duy nhất).
# Chép thành .env (không lên git). Trên VPS: /opt/troly/.env, quyền 600.
# Đổi .env xong chạy: docker compose up -d   (docker restart không nạp lại .env)

# ---------- Chung ----------
ENV=dev
TZ=UTC
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=https://localhost,http://localhost:5190
LOG_LEVEL=INFO
# VPS: https://troly.baohuynh.io.vn   Máy cá nhân: http://localhost:8200
PUBLIC_BASE_URL=http://localhost:8200
API_BIND=127.0.0.1
API_PORT=8200
TROLY_IMAGE_TAG=latest

# ---------- Cơ sở dữ liệu ----------
POSTGRES_DB=troly
POSTGRES_USER=troly
POSTGRES_PASSWORD=doi-mat-khau-nay
# Host là tên dịch vụ db trong compose; mật khẩu trùng POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://troly:doi-mat-khau-nay@db:5432/troly

# ---------- Đăng nhập ----------
# 64 byte ngẫu nhiên, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=365

# ---------- Mã hóa token Google ----------
# Một khóa Fernet: v1:<khóa>. Sinh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# ---------- AI ----------
ANTHROPIC_API_KEY=
AI_MODEL_CHAT=claude-haiku-5-5
AI_MODEL_EXTRACT=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_MAX=claude-opus-5-5
AI_EFFORT_CHAT=low
AI_COMPACT_TOKENS=30000
AI_MAX_TOOL_ROUNDS=8
AI_USER_HOURLY_TURNS=60
# Chỉ cảnh báo, không chặn (QĐ-15)
AI_MONTHLY_USD=200
AI_INBOX_MAX_ITEMS=200

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Để trống thì dựng từ R2_ACCOUNT_ID. Máy cá nhân dùng S3 giả: http://s3:5000
R2_ENDPOINT=
R2_BUCKET_FILES=troly-files
R2_BUCKET_BACKUP=troly-backup
R2_BUCKET_RELEASE=troly-release
R2_PRESIGN_SECONDS=300

# ---------- Sao lưu (QĐ-16, QĐ-27: không mã hóa age) ----------
# 6 là chủ nhật (0 là thứ Hai); giờ Việt Nam
BACKUP_WEEKDAY=6
BACKUP_HOUR=2
BACKUP_MINUTE=0
BACKUP_KEEP=5

# ---------- Google (từ V1.4, Maps từ V1.6) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MAPS_API_KEY=
GOOGLE_SYNC_MIN_SECONDS=300

# ---------- Worker ----------
WORKER_POLL_SECONDS=30
WORKER_BATCH_SIZE=200

# ---------- Thời hạn giữ (QĐ-17, QĐ-26) ----------
INBOX_RETENTION_DAYS=180
DEVICE_EVENT_RETENTION_DAYS=180
THIRD_PARTY_CHAT_RETENTION_DAYS=180
CHAT_RETENTION_DAYS=365

# ---------- Ổ đĩa ----------
DISK_WARN_PERCENT=15
DISK_STOP_PERCENT=8

# ---------- Giới hạn tần suất (12-api.md mục 3.7) ----------
RATE_LOGIN_PER_15MIN=10
RATE_DEVICE_EVENTS_PER_MIN=120
RATE_CHAT_PER_MIN=20
RATE_USER_PER_MIN=300

# ---------- Chỉ máy cá nhân (bỏ trên VPS) ----------
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
